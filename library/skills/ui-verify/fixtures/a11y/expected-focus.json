      "box": { "width": 24, "height": 24, "radius": 0 }, "requiredArea": 192, "threshold": 166.4,
      "ring": { "color": [0, 0, 0], "ratio": 21, "area": 92, "tolerancePx": 4 },
      "why": "24x24 minus 22x22 = 92 px < 166.4" },
    { "id": "pill-one", "keyboard": "PASS", "contrast": { "verdict": "PASS" }, "appearance": { "verdict": "FAIL" },
      "box": { "width": 100, "height": 40, "radius": 20 }, "requiredArea": 491.327, "threshold": 450.761,
      "ring": { "color": [0, 0, 0], "ratio": 21, "area": 242.5, "tolerancePx": 60 },
      "why": "P - pi = 242.5 px < 450.8" },
    { "id": "circle-one", "keyboard": "PASS", "contrast": { "verdict": "PASS" }, "appearance": { "verdict": "FAIL" },
      "box": { "width": 24, "height": 24, "radius": 12 }, "requiredArea": 150.796, "threshold": 127.257,
