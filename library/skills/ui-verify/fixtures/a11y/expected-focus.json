{
  "about": "Hand-computed expectations of focus-contrast.html (read by the e2e test, not by --expect). Verdicts are those of focus.contrast = focus.appearance = fail.",
  "page": "focus-contrast",
  "formulas": {
    "contrast": "WCAG relative luminance, ratio (L1 + 0.05) / (L2 + 0.05); a pixel qualifies at 3:1 between the unfocused and the focused screenshot",
    "requiredArea": "P = 2(w+h) - (8 - 2*pi) * r with r = min(radius, min(w,h)/2); requiredArea = 2P",
    "threshold": "requiredArea - 16 - 0.05 * requiredArea",
    "ringArea": "sharp rectangle: outer rectangle minus inner rectangle; rounded ring of width t inside a shape of perimeter P: P*t - pi*t*t"
  },
  "numberTolerance": 0.001,
  "elements": [
    { "id": "ring-outer", "keyboard": "PASS", "contrast": { "verdict": "PASS" }, "appearance": { "verdict": "PASS" },
      "box": { "width": 100, "height": 40, "radius": 0 }, "requiredArea": 560, "threshold": 516,
      "ring": { "color": [0, 95, 204], "ratio": 5.985, "area": 608, "tolerancePx": 4 },
      "why": "outer 108x48 minus 104x44 = 5184 - 4576 = 608 px >= 516" },
    { "id": "ring-inner", "keyboard": "PASS", "contrast": { "verdict": "PASS" }, "appearance": { "verdict": "PASS" },
      "box": { "width": 24, "height": 24, "radius": 0 }, "requiredArea": 192, "threshold": 166.4,
      "ring": { "color": [0, 0, 0], "ratio": 21, "area": 176, "tolerancePx": 4 },
      "why": "24x24 minus 20x20 = 176 px >= 192 - 16 - 9.6 = 166.4" },
    { "id": "pill-two", "keyboard": "PASS", "contrast": { "verdict": "PASS" }, "appearance": { "verdict": "PASS" },
      "box": { "width": 100, "height": 40, "radius": 20 }, "requiredArea": 491.327, "threshold": 450.761,
      "ring": { "color": [0, 0, 0], "ratio": 21, "area": 478.8, "tolerancePx": 28 },
      "why": "P = 280 - 20 * 1.716815 = 245.664; area 2P - 4*pi = 478.8; antialiasing may cost at most 28 px before the verdict changes" },
    { "id": "circle-two", "keyboard": "PASS", "contrast": { "verdict": "PASS" }, "appearance": { "verdict": "PASS" },
      "box": { "width": 24, "height": 24, "radius": 12 }, "requiredArea": 150.796, "threshold": 127.257,
      "ring": { "color": [0, 0, 0], "ratio": 21, "area": 138.2, "tolerancePx": 16 },
