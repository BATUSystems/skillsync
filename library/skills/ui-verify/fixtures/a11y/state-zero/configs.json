      "version": 1,
      "viewport": {
        "width": 1280,
        "height": 800,
        "deviceScaleFactor": 1
      },
      "secretEnv": [],
      "login": {
        "url": "<config-dir>/login.html",
        "steps": [
          {
            "fill": {
              "selector": "#user",
              "valueEnv": "UI_VERIFY_A11Y_FIXTURE_USER"
            }
          },
          {
            "fill": {
              "selector": "#pw",
              "valueEnv": "UI_VERIFY_A11Y_FIXTURE_PASSWORD"
            }
          },
          {
            "click": "#go"
          }
        ]
      },
      "pages": [
        {
          "id": "app",
          "url": "<config-dir>/app.html",
          "waitFor": null,
          "assert": {
            "selector": "#who",
            "text": "Signed in"
          },
          "checks": [
