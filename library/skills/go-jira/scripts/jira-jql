#!/usr/bin/env bash
# Wyszukiwanie JQL w Jira Cloud (zamiennik `jira ls`, bo go-jira używa usuniętego /rest/api/2/search).
# Użycie: jira-jql '<JQL>' [limit=50] [pola=summary,status,assignee,issuetype]
# Konfiguracja z ~/.jira.d/config.yml (endpoint, user); token z gopass GoJira/api-token:<user>.
set -euo pipefail
jql=${1:?usage: jira-jql '<JQL>' [limit] [fields]}
limit=${2:-50}
fields=${3:-summary,status,assignee,issuetype}
cfg=${JIRA_CONFIG:-$HOME/.jira.d/config.yml}
endpoint=$(sed -n -E "s/^endpoint: *//p" "$cfg")
user=$(sed -n -E "s/^user: *//p" "$cfg")
token=$(gopass show -o "GoJira/api-token:$user")
token_param=""; got=0
while [ "$got" -lt "$limit" ]; do
  page=$((limit - got)); [ "$page" -gt 100 ] && page=100
  args=(-sS --fail-with-body -u "$user:$token" -G "$endpoint/rest/api/3/search/jql"
        --data-urlencode "jql=$jql" --data-urlencode "maxResults=$page" --data-urlencode "fields=$fields")
  [ -n "$token_param" ] && args+=(--data-urlencode "nextPageToken=$token_param")
  resp=$(curl "${args[@]}")
  n=$(jq '.issues|length' <<<"$resp")
  jq -r '.issues[] | "\(.key): [\(.fields.status.name // "-")] \(.fields.summary) (\(.fields.assignee.displayName // "unassigned"))"' <<<"$resp"
  got=$((got + n))
  token_param=$(jq -r '.nextPageToken // empty' <<<"$resp")
  [ -z "$token_param" ] || [ "$n" -eq 0 ] && break
done
