#compdef skillsync
# skillsync completion (generated by skillsync @VERSION@; do not edit)

_skillsync_subs() {
    case "$1" in
        '') _sk_reply=('link' 'skills') ;;
        'link') _sk_reply=() ;;
        'skills') _sk_reply=('add' 'list') ;;
        'skills add') _sk_reply=() ;;
        'skills list') _sk_reply=() ;;
        *) _sk_reply=() ;;
    esac
}

_skillsync_flags() {
    case "$1" in
        '') _sk_reply=('--help' '--version' '-h') ;;
        'link') _sk_reply=('--direct' '--help' '--json' '--mode' '--out-dir' '--tag' '--target-file' '-h' '-t') ;;
        'skills') _sk_reply=('--help' '-h') ;;
        'skills add') _sk_reply=('--force' '--help' '-h') ;;
        'skills list') _sk_reply=('--help' '-h') ;;
        *) _sk_reply=() ;;
    esac
}

_skillsync_kind() {
    case "$1" in
        'link|--mode') echo choices ;;
        'link|--out-dir') echo path ;;
        'link|--target-file') echo path ;;
        'link|--direct') echo value ;;
        'link|--tag') echo value ;;
        'link|-t') echo value ;;
        *) echo none ;;
    esac
}

_skillsync_choices() {
    case "$1" in
        'link|--mode') _sk_reply=('copy' 'it'\''s' 'two words') ;;
        *) _sk_reply=() ;;
    esac
}

_skillsync_pos() {
    case "$1" in
        'skills add') _sk_reply=('alpha' 'beta') ;;
        *) _sk_reply=() ;;
    esac
}

_skillsync_poskind() {
    case "$1" in
        'link') echo path ;;
        *) echo none ;;
    esac
}

_skillsync() {
    local node='' w prev kind
    local -i i
    local -a _sk_reply
    for (( i = 2; i < CURRENT; i++ )); do
        w=$words[i]
        if [[ $w == -* ]]; then
            kind=$(_skillsync_kind "$node|$w")
            if [[ $kind != none ]]; then
                i=$(( i + 1 ))
            fi
        else
            _skillsync_subs "$node"
            if (( ${_sk_reply[(Ie)$w]} )); then
                node=${node:+$node }$w
            fi
        fi
    done
    kind=none
    if (( CURRENT > 2 )); then
        prev=$words[CURRENT-1]
        if [[ $prev == -* ]]; then
            kind=$(_skillsync_kind "$node|$prev")
        fi
    fi
    case $kind in
        path) _files; return ;;
        choices) _skillsync_choices "$node|$prev"; compadd -- "${_sk_reply[@]}"; return ;;
        value) return ;;
    esac
    if [[ $PREFIX == -* ]]; then
        _skillsync_flags "$node"
        compadd -- "${_sk_reply[@]}"
        return
    fi
    _skillsync_subs "$node"
    compadd -- "${_sk_reply[@]}"
    _skillsync_pos "$node"
    compadd -- "${_sk_reply[@]}"
    if [[ $(_skillsync_poskind "$node") == path ]]; then
        _files
    fi
}

_skillsync "$@"
