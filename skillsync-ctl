#!/usr/bin/env bash
# skillsync-watch.service control script
# systemd wrapper usługi skillsync-watch

set -euo pipefail

SERVICE="skillsync-watch.service"

cmd_start() {
    systemctl --user start "$SERVICE"
    echo "✓ Service started"
}

cmd_stop() {
    systemctl --user stop "$SERVICE"
    echo "✓ Service stopped"
}

cmd_restart() {
    systemctl --user restart "$SERVICE"
    echo "✓ Service restarted"
}

cmd_enable() {
    systemctl --user enable "$SERVICE"
    echo "✓ Service enabled (will start on login)"
}

cmd_disable() {
    systemctl --user disable "$SERVICE"
    echo "✓ Service disabled"
}

cmd_status() {
    systemctl --user status "$SERVICE"
}

cmd_logs() {
    journalctl --user -u "$SERVICE" -f
}

cmd_help() {
    cat <<EOF
Usage: $(basename "$0") <command>

Commands:
  start     - Start the service
  stop      - Stop the service
  restart   - Restart the service
  enable    - Enable auto-start on login
  disable   - Disable auto-start
  status    - Show service status
  logs      - Follow service logs (Ctrl+C to exit)

The service runs 'skillsync watch' in the background and monitors
the copilot library for changes, auto-linking to all discovered projects.
EOF
}

case "${1:-help}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_restart ;;
    enable)  cmd_enable ;;
    disable) cmd_disable ;;
    status)  cmd_status ;;
    logs)    cmd_logs ;;
    *)       cmd_help ;;
esac
